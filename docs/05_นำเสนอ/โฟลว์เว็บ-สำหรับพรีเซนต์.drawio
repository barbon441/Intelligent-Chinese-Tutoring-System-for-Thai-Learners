        <mxCell id="quiz" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" value="&lt;b&gt;ควิซท้ายหมวด&lt;/b&gt;&lt;br&gt;10 ข้อ โหมดสอบ&lt;br&gt;ได้ ≥ 7 ข้อไหม?" vertex="1">
