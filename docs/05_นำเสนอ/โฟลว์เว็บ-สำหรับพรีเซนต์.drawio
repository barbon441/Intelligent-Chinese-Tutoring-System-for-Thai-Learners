<mxfile host="app.diagrams.net"><diagram id="flow-present" name="โฟลว์การใช้งาน"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="โฟลว์การใช้งานเว็บ — ระบบติวเตอร์ภาษาจีนอัจฉริยะสำหรับคนไทย" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="legend" value="เส้นทึบ = ใช้งานได้แล้ววันนี้ · เส้นประ = กำลังพัฒนา" style="text;html=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="500" height="24" as="geometry"/></mxCell><mxCell id="start" value="ผู้เรียน&lt;br&gt;เข้าเว็บ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="120" height="70" as="geometry"/></mxCell><mxCell id="d_first" value="เข้าครั้งแรก&lt;br&gt;หรือเปล่า?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="210" y="330" width="150" height="110" as="geometry"/></mxCell><mxCell id="onboard" value="&lt;b&gt;ตอบคำถามแรกเข้า 3 ข้อ&lt;/b&gt;&lt;br&gt;เป้าระดับไหน · มีวันสอบไหม&lt;br&gt;ตอนนี้ทำอะไรได้บ้าง &lt;i&gt;(ข้ามได้)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a2e;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="80" width="240" height="100" as="geometry"/></mxCell><mxCell id="pretest" value="&lt;b&gt;แบบทดสอบก่อนเรียน&lt;br&gt;(Pre-test)&lt;/b&gt;&lt;br&gt;เก็บคะแนนฐาน ครอบ 5 หมวด" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="220" height="100" as="geometry"/></mxCell><mxCell id="d_level" value="ผลเป็น&lt;br&gt;อย่างไร?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="150" height="120" as="geometry"/></mxCell><mxCell id="foundation" value="&lt;b&gt;บทปูพื้นฐานเสียง&lt;/b&gt;&lt;br&gt;พินอินเทียบไทย · วรรณยุกต์&lt;br&gt;เกมฝึกหูแยกเสียง" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1270" y="80" width="220" height="100" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;หน้าแรก&lt;/b&gt;&lt;br&gt;ดาวนำทางบอกว่า&lt;br&gt;วันนี้ควรทำอะไรต่อ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="430" y="340" width="180" height="100" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;เลือกหมวดเรียน&lt;/b&gt;&lt;br&gt;5 หมวด เรียงง่าย → ยาก" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="680" y="350" width="190" height="80" as="geometry"/></mxCell><mxCell id="flash" value="&lt;b&gt;เรียนบัตรคำ&lt;/b&gt;&lt;br&gt;ชุดวันนี้ 10 คำ&lt;br&gt;มีเสียง + ปุ่มฟังช้า" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="930" y="340" width="180" height="100" as="geometry"/></mxCell><mxCell id="practice" value="&lt;b&gt;ฝึก 4 โหมด&lt;/b&gt;&lt;br&gt;ฟัง · อ่าน · เรียงประโยค · จับคู่&lt;br&gt;&lt;i&gt;ใช้เฉพาะคำที่เรียนแล้ว&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1170" y="340" width="220" height="100" as="geometry"/></mxCell><mxCell id="quiz" value="&lt;b&gt;ควิซท้ายหมวด&lt;/b&gt;&lt;br&gt;10 ข้อ โหมดสอบ&lt;br&gt;ได้ ≥ 7 ข้อไหม?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1450" y="320" width="200" height="140" as="geometry"/></mxCell><mxCell id="pass" value="&lt;b&gt;ผ่าน 🎉&lt;/b&gt;&lt;br&gt;ปลดควิซ&lt;br&gt;หมวดถัดไป" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#4a7d4a;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1730" y="210" width="160" height="90" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;ไม่ผ่าน&lt;/b&gt;&lt;br&gt;ดูเฉลย + ฝึกข้อที่พลาด&lt;br&gt;สอบใหม่ได้ไม่จำกัด" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1710" y="480" width="200" height="90" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;ระบบทบทวนอัตโนมัติ&lt;/b&gt;&lt;br&gt;คำที่ใกล้ลืมเด้งกลับมาให้ทวน&lt;br&gt;ตามจังหวะลืมของแต่ละคน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="680" y="590" width="260" height="90" as="geometry"/></mxCell><mxCell id="posttest" value="&lt;b&gt;ครบ 5 หมวด →&lt;br&gt;สอบวัดผลหลังเรียน (Post-test)&lt;/b&gt;&lt;br&gt;ข้อสอบเสมือน HSK1 จับเวลา&lt;br&gt;&lt;i&gt;(กำลังพัฒนา)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a2e;dashed=1;" vertex="1" parent="1"><mxGeometry x="1960" y="200" width="220" height="110" as="geometry"/></mxCell><mxCell id="report" value="&lt;b&gt;ใบรายงานผล&lt;/b&gt;&lt;br&gt;เทียบคะแนนก่อน/หลังเรียน&lt;br&gt;จุดอ่อนรายทักษะ + ปุ่มฝึกเจาะ&lt;br&gt;&lt;i&gt;(กำลังพัฒนา)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#4a7d4a;strokeWidth=2;fontColor=#1a1a2e;dashed=1;" vertex="1" parent="1"><mxGeometry x="1960" y="380" width="220" height="110" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1f6f9f;" edge="1" parent="1" source="start" target="d_first"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="ครั้งแรก" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1f6f9f;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_first" target="onboard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="เคยแล้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1f6f9f;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_first" target="home"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1f6f9f;" edge="1" parent="1" source="onboard" target="pretest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1f6f9f;" edge="1" parent="1" source="pretest" target="d_level"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="คะแนนต่ำมาก /
