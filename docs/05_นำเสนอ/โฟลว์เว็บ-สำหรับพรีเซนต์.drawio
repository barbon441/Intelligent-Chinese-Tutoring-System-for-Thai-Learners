        </mxCell>
        <mxCell id="d_first" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" value="เข้าครั้งแรก&lt;br&gt;หรือเปล่า?" vertex="1">
          <mxGeometry height="110" width="150" x="210" y="330" as="geometry" />
