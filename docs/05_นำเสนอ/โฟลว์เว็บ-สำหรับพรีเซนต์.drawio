<mxfile host="app.diagrams.net"><diagram id="flow-present" name="โฟลว์การใช้งาน"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1754" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="โฟลว์การใช้งานเว็บ — ระบบติวเตอร์ภาษาจีนอัจฉริยะสำหรับคนไทย" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="40" as="geometry"/></mxCell><mxCell id="start" value="ผู้เรียน&lt;br&gt;เข้าเว็บ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="120" height="70" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;หน้าแรก&lt;/b&gt;&lt;br&gt;ดาวนำทางบอกว่า&lt;br&gt;วันนี้ควรทำอะไรต่อ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="220" y="185" width="180" height="100" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;เลือกหมวดเรียน&lt;/b&gt;&lt;br&gt;5 หมวด เรียงง่าย → ยาก" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="460" y="195" width="190" height="80" as="geometry"/></mxCell><mxCell id="flash" value="&lt;b&gt;เรียนบัตรคำ&lt;/b&gt;&lt;br&gt;ชุดวันนี้ 10 คำ&lt;br&gt;มีเสียง + ปุ่มฟังช้า" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="710" y="185" width="180" height="100" as="geometry"/></mxCell><mxCell id="practice" value="&lt;b&gt;ฝึก 4 โหมด&lt;/b&gt;&lt;br&gt;ฟัง · อ่าน · เรียงประโยค · จับคู่&lt;br&gt;&lt;i&gt;ใช้เฉพาะคำที่เรียนแล้ว&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#dae8fc;strokeColor=#1f6f9f;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="950" y="185" width="220" height="100" as="geometry"/></mxCell><mxCell id="quiz" value="&lt;b&gt;ควิซท้ายหมวด&lt;/b&gt;&lt;br&gt;10 ข้อ โหมดสอบ&lt;br&gt;ได้ ≥ 7 ข้อไหม?" style="rhombus;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1240" y="165" width="200" height="140" as="geometry"/></mxCell><mxCell id="pass" value="&lt;b&gt;ผ่าน 🎉&lt;/b&gt;&lt;br&gt;ปลดควิซ&lt;br&gt;หมวดถัดไป" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#4a7d4a;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1520" y="60" width="160" height="90" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;ไม่ผ่าน&lt;/b&gt;&lt;br&gt;ดูเฉลย + ฝึกข้อที่พลาด&lt;br&gt;สอบใหม่ได้ไม่จำกัด" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="200" height="90" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;ระบบทบทวนอัตโนมัติ&lt;/b&gt;&lt;br&gt;คำที่ใกล้ลืมเด้งกลับมาให้ทวน&lt;br&gt;ตามจังหวะลืมของแต่ละคน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="260" height="90" as="geometry"/></mxCell><mxCell id="mock" value="&lt;b&gt;ครบ 5 หมวด&lt;/b&gt;&lt;br&gt;ข้อสอบจำลองเต็มชุด&lt;br&gt;&lt;i&gt;(กำลังพัฒนา)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#4a7d4a;strokeWidth=2;fontColor=#1a1a2e;dashed=1;" vertex="1" parent="1"><mxGeometry x="1520" y="430" width="180" height="90" as="geometry"/></mxCell><mxCe