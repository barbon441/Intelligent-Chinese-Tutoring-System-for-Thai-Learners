        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#1a1a2e;" value="ผู้เรียน&lt;br&gt;เข้าเว็บ" vertex="1">
