        <mxCell id="onboard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#1a1a2e;dashed=1;" value="&lt;b&gt;ตอบคำถามก่อนเข้าใช้งาน&lt;/b&gt;&amp;nbsp;&lt;i&gt;(ข้ามได้)&lt;/i&gt;" vertex="1">
